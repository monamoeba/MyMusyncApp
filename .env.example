# Copy this file to .env and fill in real values. .env is gitignored -
# never commit it.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base URL the app is served from locally. Must match the redirect URIs you
# register with Google Cloud Console and the Spotify Developer Dashboard,
# e.g. http://127.0.0.1:8000/ytsourcecallback/ and .../spdestcallback/
SITE_BASE_URL=http://127.0.0.1:8000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application, with the YouTube Data API v3 enabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Spotify Developer Dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
